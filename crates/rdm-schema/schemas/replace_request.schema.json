{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "description": "A request: a header and one operation.",
  "type": "object",
  "properties": {
    "header": {
      "$ref": "#/$defs/Header"
    },
    "op": {
      "$ref": "#/$defs/ReplaceOp"
    }
  },
  "required": [
    "header",
    "op"
  ],
  "$defs": {
    "Header": {
      "description": "What every request carries.",
      "type": "object",
      "properties": {
        "op_id": {
          "description": "The retry key: a retried write with a known `op_id` returns the first outcome.",
          "anyOf": [
            {
              "$ref": "#/$defs/OpId"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "description": "Stamped on the amendment or comment the operation writes.",
          "$ref": "#/$defs/Actor"
        },
        "note": {
          "description": "The amendment's words (`The amendment rule`).",
          "anyOf": [
            {
              "$ref": "#/$defs/EditNote"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actor"
      ]
    },
    "OpId": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]{1,128}$"
    },
    "Actor": {
      "description": "Who made a move, a comment or an amendment.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": true
    },
    "ActorKind": {
      "description": "`Actor.kind`.",
      "type": "string",
      "enum": [
        "agent",
        "human",
        "import"
      ]
    },
    "EditNote": {
      "description": "The note of an amendment: why a content or structure edit was made.",
      "type": "object",
      "properties": {
        "description": {
          "description": "Non-blank. When `correction` is true, it is the reason.",
          "type": "string"
        },
        "source": {
          "description": "The report that justified the edit.",
          "type": [
            "string",
            "null"
          ]
        },
        "correction": {
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "correction"
      ]
    },
    "ReplaceOp": {
      "description": "Replaces one node file if its current `rev` is `expected_rev`. It cannot change `id`, `name`,\n`parent_id` or `order`.",
      "type": "object",
      "properties": {
        "expected_rev": {
          "description": "Required outside a batch; inside one, `None` only for a node the batch created.",
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ]
        },
        "node": {
          "$ref": "#/$defs/Node"
        }
      },
      "required": [
        "node"
      ]
    },
    "Rev": {
      "description": "The revision of one node: a hash of its canonical encoding (`store.md`, §Revisions).\nConsumers compare for equality and never parse.",
      "type": "string"
    },
    "Node": {
      "description": "A node of the campaign: a directory (or the campaign root) or a leaf.\n\nNot a serde-tagged enum: `Directory.kind` already holds `campaign` or `directory`, so the\ndeserialiser reads `kind` and picks the type.",
      "anyOf": [
        {
          "$ref": "#/$defs/Directory"
        },
        {
          "$ref": "#/$defs/Leaf"
        }
      ]
    },
    "Directory": {
      "description": "`_dir.json`: the campaign root and every directory node.",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "kind": {
          "$ref": "#/$defs/DirectoryKind"
        },
        "name": {
          "description": "The path segment; for the campaign root, the campaign slug.",
          "$ref": "#/$defs/Name"
        },
        "parent_id": {
          "description": "The directory this node is in. Absent exactly for the campaign root.",
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "description": "Position among siblings. Absent exactly for the campaign root.",
          "anyOf": [
            {
              "$ref": "#/$defs/OrderKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "goal": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "success_gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "gotchas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mark"
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "kind",
        "name",
        "title",
        "context",
        "references",
        "goal",
        "preconditions",
        "success_gates",
        "gotchas",
        "notes",
        "marks"
      ],
      "additionalProperties": true
    },
    "NodeId": {
      "type": "string",
      "pattern": "^n_[0123456789abcdefghjkmnpqrstvwxyz]{8}$"
    },
    "DirectoryKind": {
      "description": "`Directory.kind`.",
      "type": "string",
      "enum": [
        "campaign",
        "directory"
      ]
    },
    "Name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "OrderKey": {
      "description": "The position of a node among its siblings. Opaque: its format and how a key is made\nbetween two others are `store.md`'s (§Order key). Compared as given, never parsed.",
      "type": "string"
    },
    "Reference": {
      "description": "An element of `references`.",
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_id": {
          "description": "The campaign node the reference names, when it names one. `target` is then absent: it is\nderived on read from the path of that node.",
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": true
    },
    "Criterion": {
      "description": "An element of `preconditions` or `success_gates`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable id, minted at creation, never a position (`Stable identity`).",
          "$ref": "#/$defs/CriterionId"
        },
        "text": {
          "type": "string"
        },
        "met": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "met"
      ],
      "additionalProperties": true
    },
    "CriterionId": {
      "type": "string",
      "pattern": "^c_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
    },
    "Mark": {
      "description": "An element of `Leaf.marks` or `Directory.marks`: one change of one criterion's `met`.",
      "type": "object",
      "properties": {
        "ts": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "criterion_id": {
          "description": "The `id` of the criterion, in `preconditions` or `success_gates`. Never a position.",
          "$ref": "#/$defs/CriterionId"
        },
        "met": {
          "description": "The new value of `met`.",
          "type": "boolean"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why the mark was made. Required and not blank when `correction` is `true`.",
          "type": [
            "string",
            "null"
          ]
        },
        "correction": {
          "description": "`true` when the mark was made on a finished node.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "ts",
        "actor",
        "criterion_id",
        "met"
      ],
      "additionalProperties": true
    },
    "Leaf": {
      "description": "`<leaf>.json`.",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "kind": {
          "$ref": "#/$defs/LeafKind"
        },
        "name": {
          "description": "The path segment, unique among the children of one parent.",
          "$ref": "#/$defs/Name"
        },
        "parent_id": {
          "description": "The directory this leaf is in.",
          "$ref": "#/$defs/NodeId"
        },
        "order": {
          "description": "Position among siblings, opaque.",
          "$ref": "#/$defs/OrderKey"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "goal": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "success_gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/History"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mark"
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "kind",
        "name",
        "parent_id",
        "order",
        "title",
        "status",
        "goal",
        "preconditions",
        "success_gates",
        "references",
        "steps",
        "progress",
        "history",
        "marks"
      ],
      "additionalProperties": true
    },
    "LeafKind": {
      "description": "`Leaf.kind`, the one value `leaf`.",
      "type": "string",
      "enum": [
        "leaf"
      ]
    },
    "Status": {
      "description": "The five statuses of a leaf (`statuses.md`).",
      "type": "string",
      "enum": [
        "planned",
        "ongoing",
        "paused",
        "cancelled",
        "done"
      ]
    },
    "Step": {
      "description": "An element of `Leaf.steps`.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/StepId"
        },
        "title": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "implementation_logic": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Check"
          }
        },
        "commit": {
          "$ref": "#/$defs/Commit"
        },
        "requires": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "done": {
          "type": "boolean"
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "done_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "goal",
        "implementation_logic",
        "deliverables",
        "references",
        "checks",
        "commit",
        "done"
      ],
      "additionalProperties": true
    },
    "StepId": {
      "type": "string",
      "pattern": "^s_[0123456789abcdefghjkmnpqrstvwxyz]{6}$"
    },
    "Check": {
      "description": "An element of `Step.checks`.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/Expected"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "text",
        "expected"
      ],
      "additionalProperties": true
    },
    "Expected": {
      "description": "`Check.expected`.",
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "Commit": {
      "description": "`Step.commit`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "breaking": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "breaking",
        "summary"
      ],
      "additionalProperties": true
    },
    "Progress": {
      "description": "`Leaf.progress`.",
      "type": "object",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commits": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "notes"
      ],
      "additionalProperties": true
    },
    "History": {
      "description": "An element of `Leaf.history`: one status move.",
      "type": "object",
      "properties": {
        "ts": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/Status"
        },
        "to": {
          "$ref": "#/$defs/Status"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "override": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "op_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpId"
            },
            {
              "type": "null"
            }
          ]
        },
        "correction": {
          "description": "`true` for a reversal out of `done`; `reason` is then required and not blank.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "ts",
        "from",
        "to",
        "actor"
      ],
      "additionalProperties": true
    }
  }
}
