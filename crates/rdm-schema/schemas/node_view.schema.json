{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodeView",
  "description": "Node detail.",
  "type": "object",
  "properties": {
    "read_model_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "format_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "projection": {
      "$ref": "#/$defs/Projection"
    },
    "campaign": {
      "$ref": "#/$defs/CampaignRef"
    },
    "tree_rev": {
      "type": "string"
    },
    "node": {
      "$ref": "#/$defs/NodeDetail"
    },
    "holders": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Holder"
      }
    }
  },
  "required": [
    "read_model_version",
    "format_version",
    "projection",
    "campaign",
    "tree_rev",
    "node",
    "holders"
  ],
  "additionalProperties": true,
  "$defs": {
    "Projection": {
      "description": "Which projection a payload is.",
      "type": "string",
      "enum": [
        "outline",
        "node",
        "ready",
        "amendments"
      ]
    },
    "CampaignRef": {
      "description": "Identity of the campaign in an envelope.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "title"
      ],
      "additionalProperties": true
    },
    "NodeDetail": {
      "description": "The detail of one node, discriminated by `kind`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "leaf"
            }
          },
          "$ref": "#/$defs/LeafDetail",
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "directory"
            }
          },
          "$ref": "#/$defs/DirectoryDetail",
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Status": {
      "description": "The five statuses of a leaf (`statuses.md`).",
      "type": "string",
      "enum": [
        "planned",
        "ongoing",
        "paused",
        "cancelled",
        "done"
      ]
    },
    "LevelSource": {
      "description": "The rule that produced a `level`. One value today.",
      "type": "string",
      "enum": [
        "depth"
      ]
    },
    "Criterion": {
      "description": "An element of `preconditions` or `success_gates`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable id, minted at creation, never a position (`Stable identity`).",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "met": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "met"
      ],
      "additionalProperties": true
    },
    "Reference": {
      "description": "An element of `references`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable id.",
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_id": {
          "description": "The campaign node the reference names, when it names one. Followed over `target`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": true
    },
    "StepView": {
      "description": "A stored step plus its derived number.",
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "implementation_logic": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Check"
          }
        },
        "commit": {
          "$ref": "#/$defs/Commit"
        },
        "requires": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "done": {
          "type": "boolean"
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "done_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "number",
        "id",
        "title",
        "goal",
        "implementation_logic",
        "deliverables",
        "references",
        "checks",
        "commit",
        "done"
      ],
      "additionalProperties": true
    },
    "Check": {
      "description": "An element of `Step.checks`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable id.",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/Expected"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "text",
        "expected"
      ],
      "additionalProperties": true
    },
    "Expected": {
      "description": "`Check.expected`.",
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "Commit": {
      "description": "`Step.commit`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "breaking": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "breaking",
        "summary"
      ],
      "additionalProperties": true
    },
    "Progress": {
      "description": "`Leaf.progress`.",
      "type": "object",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commits": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "notes"
      ],
      "additionalProperties": true
    },
    "StepCounts": {
      "description": "`{done, total}` of a leaf's steps.",
      "type": "object",
      "properties": {
        "done": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "done",
        "total"
      ],
      "additionalProperties": true
    },
    "History": {
      "description": "An element of `Leaf.history`: one status move.",
      "type": "object",
      "properties": {
        "ts": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/Status"
        },
        "to": {
          "$ref": "#/$defs/Status"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "override": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "op_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "correction": {
          "description": "`true` for a reversal out of `done`; `reason` is then required and not blank.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "ts",
        "from",
        "to",
        "actor"
      ],
      "additionalProperties": true
    },
    "Actor": {
      "description": "Who made a move, a comment or an amendment.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": true
    },
    "ActorKind": {
      "description": "`Actor.kind`.",
      "type": "string",
      "enum": [
        "agent",
        "human",
        "import"
      ]
    },
    "Mark": {
      "description": "An element of `Leaf.marks` or `Directory.marks`: one change of one criterion's `met`.",
      "type": "object",
      "properties": {
        "ts": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "criterion_id": {
          "description": "The `id` of the criterion, in `preconditions` or `success_gates`. Never a position.",
          "type": "string"
        },
        "met": {
          "description": "The new value of `met`.",
          "type": "boolean"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why the mark was made. Required and not blank when `correction` is `true`.",
          "type": [
            "string",
            "null"
          ]
        },
        "correction": {
          "description": "`true` when the mark was made on a finished node.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "ts",
        "actor",
        "criterion_id",
        "met"
      ],
      "additionalProperties": true
    },
    "Comment": {
      "description": "`_comments/<ulid>.json`.",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "ts": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "op_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "node_id",
        "ts",
        "actor",
        "text"
      ],
      "additionalProperties": true
    },
    "LeafDetail": {
      "description": "Detail of a leaf.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "rev": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status_since": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "level_source": {
          "$ref": "#/$defs/LevelSource"
        },
        "ready": {
          "type": "boolean"
        },
        "held_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "finished": {
          "type": "boolean"
        },
        "correction_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "goal": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "success_gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepView"
          }
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "commit_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "step_progress": {
          "$ref": "#/$defs/StepCounts"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/History"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mark"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Comment"
          }
        },
        "amendments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "added_by": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "parent",
        "rev",
        "title",
        "status",
        "level",
        "level_source",
        "ready",
        "held_by",
        "finished",
        "correction_count",
        "goal",
        "preconditions",
        "success_gates",
        "references",
        "steps",
        "progress",
        "step_progress",
        "history",
        "marks",
        "comments",
        "amendments"
      ],
      "additionalProperties": true
    },
    "StatusCounts": {
      "description": "Leaves counted by status.",
      "type": "object",
      "properties": {
        "planned": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ongoing": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "paused": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "done": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "planned",
        "ongoing",
        "paused",
        "cancelled",
        "done"
      ],
      "additionalProperties": true
    },
    "ChildRef": {
      "description": "A child in a directory's detail.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        }
      },
      "required": [
        "id",
        "path",
        "kind",
        "title",
        "status"
      ],
      "additionalProperties": true
    },
    "NodeKind": {
      "description": "`NodeKind` of a child reference.",
      "type": "string",
      "enum": [
        "leaf",
        "directory"
      ]
    },
    "DirectoryDetail": {
      "description": "Detail of a directory or the campaign root.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "rev": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "finished": {
          "type": "boolean"
        },
        "correction_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Comment"
          }
        },
        "amendments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "added_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_campaign": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "counts": {
          "$ref": "#/$defs/StatusCounts"
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goal": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "success_gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "gotchas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mark"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChildRef"
          }
        }
      },
      "required": [
        "id",
        "path",
        "parent",
        "rev",
        "title",
        "finished",
        "correction_count",
        "comments",
        "amendments",
        "is_campaign",
        "status",
        "counts",
        "context",
        "goal",
        "preconditions",
        "success_gates",
        "references",
        "gotchas",
        "notes",
        "marks",
        "children"
      ],
      "additionalProperties": true
    },
    "Holder": {
      "description": "A leaf that holds another back.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "title",
        "status"
      ],
      "additionalProperties": true
    }
  }
}
