{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amendment",
  "description": "`_amendments/<ulid>.json`.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string"
    },
    "legacy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ts": {
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "op_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Change"
      }
    },
    "snapshot": true
  },
  "required": [
    "schema_version",
    "id",
    "ts",
    "actor",
    "description",
    "changes"
  ],
  "additionalProperties": true,
  "$defs": {
    "Actor": {
      "description": "Who made a move, a comment or an amendment.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": true
    },
    "ActorKind": {
      "description": "`Actor.kind`.",
      "type": "string",
      "enum": [
        "agent",
        "human",
        "import"
      ]
    },
    "Change": {
      "description": "An element of `Amendment.changes`.",
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/ChangeOp"
        },
        "path_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "path_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "old": true,
        "new": true
      },
      "required": [
        "node_id",
        "op"
      ],
      "additionalProperties": true
    },
    "ChangeOp": {
      "description": "`Change.op`.",
      "type": "string",
      "enum": [
        "add",
        "remove",
        "set",
        "rename",
        "move"
      ]
    }
  }
}
