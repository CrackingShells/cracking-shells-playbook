{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadyView",
  "description": "The ready set with what stalls the rest.",
  "type": "object",
  "properties": {
    "campaign": {
      "$ref": "#/$defs/CampaignRef"
    },
    "format_version": {
      "type": "string"
    },
    "holders": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Holder"
      }
    },
    "projection": {
      "$ref": "#/$defs/Projection"
    },
    "read_model_version": {
      "type": "string"
    },
    "ready": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReadyLeaf"
      }
    },
    "stalled": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StalledLeaf"
      }
    },
    "tree_rev": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "read_model_version",
    "format_version",
    "projection",
    "campaign",
    "tree_rev",
    "ready",
    "stalled",
    "holders"
  ],
  "$defs": {
    "CampaignRef": {
      "description": "Identity of the campaign in an envelope.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "path",
        "title"
      ]
    },
    "Holder": {
      "description": "A leaf that holds another back.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "title",
        "status"
      ]
    },
    "LevelSource": {
      "description": "The rule that produced a `level`. One value today.",
      "type": "string",
      "enum": [
        "depth"
      ]
    },
    "Projection": {
      "description": "Which projection a payload is.",
      "type": "string",
      "enum": [
        "outline",
        "node",
        "ready",
        "amendments"
      ]
    },
    "ReadyLeaf": {
      "description": "A `planned` leaf that nothing holds back.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "level_source": {
          "$ref": "#/$defs/LevelSource"
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "path",
        "title",
        "level",
        "level_source"
      ]
    },
    "StalledLeaf": {
      "description": "A `planned` leaf held back by unfinished leaves.",
      "type": "object",
      "properties": {
        "held_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "level_source": {
          "$ref": "#/$defs/LevelSource"
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "path",
        "title",
        "level",
        "level_source",
        "held_by"
      ]
    },
    "Status": {
      "description": "The five statuses of a leaf (`statuses.md`).",
      "type": "string",
      "enum": [
        "planned",
        "ongoing",
        "paused",
        "cancelled",
        "done"
      ]
    }
  }
}
