{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Directory",
  "description": "`_dir.json`: the campaign root and every directory node.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/DirectoryKind"
    },
    "title": {
      "type": "string"
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Reference"
      }
    },
    "goal": {
      "type": "string"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Criterion"
      }
    },
    "success_gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Criterion"
      }
    },
    "gotchas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Mark"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "context",
    "references",
    "goal",
    "preconditions",
    "success_gates",
    "gotchas",
    "notes",
    "marks"
  ],
  "additionalProperties": true,
  "$defs": {
    "DirectoryKind": {
      "description": "`Directory.kind`.",
      "type": "string",
      "enum": [
        "campaign",
        "directory"
      ]
    },
    "Reference": {
      "description": "An element of `references`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable id.",
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_id": {
          "description": "The campaign node the reference names, when it names one. Followed over `target`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": true
    },
    "Criterion": {
      "description": "An element of `preconditions` or `success_gates`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable id, minted at creation, never a position (`Stable identity`).",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "met": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "met"
      ],
      "additionalProperties": true
    },
    "Mark": {
      "description": "An element of `Leaf.marks` or `Directory.marks`: one change of one criterion's `met`.",
      "type": "object",
      "properties": {
        "ts": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "criterion_id": {
          "description": "The `id` of the criterion, in `preconditions` or `success_gates`. Never a position.",
          "type": "string"
        },
        "met": {
          "description": "The new value of `met`.",
          "type": "boolean"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why the mark was made. Required and not blank when `correction` is `true`.",
          "type": [
            "string",
            "null"
          ]
        },
        "correction": {
          "description": "`true` when the mark was made on a finished node.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "ts",
        "actor",
        "criterion_id",
        "met"
      ],
      "additionalProperties": true
    },
    "Actor": {
      "description": "Who made a move, a comment or an amendment.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": true
    },
    "ActorKind": {
      "description": "`Actor.kind`.",
      "type": "string",
      "enum": [
        "agent",
        "human",
        "import"
      ]
    }
  }
}
